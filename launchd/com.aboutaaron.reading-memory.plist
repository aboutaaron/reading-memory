<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for Reading Memory.

  This is a TEMPLATE. Substitute the placeholders before copying to
  ~/Library/LaunchAgents/com.aboutaaron.reading-memory.plist:

    __HOME__           absolute path to your home directory (output of `echo $HOME`)
    __INSTALL_DIR__    absolute path to the reading-memory checkout (e.g. /Users/you/Code/reading-memory)
    __PATH__           a sane PATH for node/npm (e.g. /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin)

  Then load it:

    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aboutaaron.reading-memory.plist

  And to unload / remove:

    launchctl bootout gui/$(id -u)/com.aboutaaron.reading-memory

  Logs land at __HOME__/.reading-api/launchd-stdout.log and launchd-stderr.log.
  Source the env file the same way the systemd unit does — via the wrapper at
  launchd/start.sh, which loads __HOME__/.reading-api/env before invoking
  `npm start`. The env file is generated by `npx reading-memory setup`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aboutaaron.reading-memory</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__INSTALL_DIR__/launchd/start.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.reading-api/launchd-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.reading-api/launchd-stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
