[Unit]
Description=Back up Reading API SQLite database

[Service]
Type=oneshot
WorkingDirectory=%h/reading-api
EnvironmentFile=%h/.reading-api/env
ExecStart=%h/reading-api/scripts/backup-sqlite.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.reading-api %h/backups/reading-api
