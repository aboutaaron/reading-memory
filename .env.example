READING_API_TOKEN=replace-with-generated-token
READING_API_HOST=127.0.0.1
READING_API_PORT=4727
READING_API_DATA_DIR=/home/YOUR_USER/.reading-api
READING_API_DB=/home/YOUR_USER/.reading-api/reading.sqlite
READING_API_BACKUP_DIR=/home/YOUR_USER/backups/reading-memory
READING_API_FLUE_MODEL=openai/gpt-5.5
OPENAI_API_KEY=replace-with-openai-api-key
READING_API_FLUE_TRACE_PATH=/home/YOUR_USER/.reading-api/flue-events.jsonl

# Optional: per-provider baseUrl overrides for Flue analysis traffic.
# Reading Memory will route the resolved Model's HTTP calls through these
# URLs instead of the upstream defaults. Useful for corporate proxies,
# Cloudflare AI Gateway, or self-hosted gateways. The env var name follows
# the resolved provider with hyphens replaced by underscores, uppercased,
# suffixed with _BASE_URL — matches the official Anthropic and OpenAI SDK
# conventions where applicable.
# OPENAI_BASE_URL=https://your-openai-proxy.example.com
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy.example.com
# CLOUDFLARE_AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openai
