{
  "name": "reading-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback-only durable reading memory harness for local agents.",
  "bin": {
    "reading-memory": "./scripts/setup.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/src/index.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/db && cp src/db/schema.sql dist/src/db/schema.sql && cp src/ingest/pdf-worker.mjs dist/src/ingest/pdf-worker.mjs && rm -rf dist/.agents && cp -R .agents dist/.agents",
    "test": "node --test --import tsx 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "eval:reading": "node --import tsx src/evals/reading-memory-eval.ts",
    "reanalyze": "node --import tsx scripts/reanalyze.ts",
    "backfill:titles": "node --import tsx scripts/backfill-titles.ts",
    "run-ledger": "node scripts/run-ledger.mjs",
    "smoke": "tsx scripts/smoke-test.ts",
    "traces": "tsx scripts/inspect-traces.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.6.0",
    "@valibot/to-json-schema": "1.6.0",
    "linkedom": "0.18.13",
    "openai": "6.26.0",
    "pdf-parse": "1.1.1",
    "undici": "8.10.2",
    "valibot": "1.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
