READING_API_TOKEN=replace-with-generated-token
READING_API_HOST=127.0.0.1
READING_API_PORT=4727
READING_API_DATA_DIR=/home/YOUR_USER/.reading-api
READING_API_DB=/home/YOUR_USER/.reading-api/reading.sqlite
READING_API_BACKUP_DIR=/home/YOUR_USER/backups/reading-memory
READING_API_MODEL=gpt-5.6-luna
# Compatibility fallback: READING_API_FLUE_MODEL=openai/gpt-5.6-luna
OPENAI_API_KEY=replace-with-openai-api-key
READING_API_FLUE_TRACE_PATH=/home/YOUR_USER/.reading-api/flue-events.jsonl

# Optional: route official SDK traffic through an API-compatible proxy.
# OpenAI expects the full API prefix, usually /v1. Anthropic defaults to its origin.
# OPENAI_BASE_URL=https://your-openai-proxy.example.com/v1
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy.example.com
# For Anthropic also set READING_API_MODEL=anthropic/claude-sonnet-4-5
# and ANTHROPIC_API_KEY. Other provider prefixes are not supported.
