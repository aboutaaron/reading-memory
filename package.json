{
  "name": "reading-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback-only durable reading memory harness for local agents.",
  "bin": {
    "reading-memory": "./scripts/setup.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/src/index.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/db && cp src/db/schema.sql dist/src/db/schema.sql && rm -rf dist/.agents && cp -R .agents dist/.agents",
    "test": "node --test --import tsx 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "smoke": "tsx scripts/smoke-test.ts",
    "traces": "tsx scripts/inspect-traces.ts"
  },
  "dependencies": {
    "@flue/sdk": "0.3.6",
    "pdf-parse": "1.1.1",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "just-bash": {
      "fast-xml-parser": "5.7.2"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
